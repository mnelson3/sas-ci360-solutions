# SAS CI360 Environment Configuration
# Copy this file to .env and fill in your values

# CI360 API Configuration
CI360_HOST=https://extapigwservice-prod.ci360.sas.com
CI360_SECRET_KEY=your-secret-key-here
CI360_TENANT_ID=your-tenant-id-here

# Optional overrides
CI360_ALGORITHM=HS256
CI360_API=/marketingGateway
CI360_ENCODING=UTF-8

# Config file path (optional)
CI360_CONFIG_PATH=
